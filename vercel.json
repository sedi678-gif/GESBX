{
  "framework": "nextjs",
  "rewrites": [
    { "source": "/api/payout/request", "destination": "https://us-central1-youstu-cab15.cloudfunctions.net/paypalPayoutRequest" },
    { "source": "/api/webhooks/paypal", "destination": "https://us-central1-youstu-cab15.cloudfunctions.net/paypalWebhook" },
    { "source": "/model/:path*", "destination": "/models/:path*" },
    { "source": "/models/Mutant/:path*", "destination": "/models/mutant/:path*" }
  ],
  "headers": [
    {
      "source": "/models/(.*)\\.glb",
      "headers": [
        { "key": "Content-Type", "value": "model/gltf-binary" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/models/(.*)\\.gltf",
      "headers": [
        { "key": "Content-Type", "value": "model/gltf+json" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/models/(.*)\\.fbx",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
