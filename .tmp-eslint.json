Id';\n\nimport {\n\n  resolvePlayerManat,\n\n  manatWritePatch,\n\n  clearLegacyBalanceStorage,\n\n} from '@/app/lib/manat';\n\n\n\ninterface UserContextType {\n\n  user: User | null;\n\n  userId: string;\n\n  manat: number;\n\n  manatReady: boolean;\n\n  playerProfile: PlayerProfile | null;\n\n  addManat: (amount: number) => Promise<void>;\n\n  spendManat: (amount: number) => Promise<boolean>;\n\n  applyManatDelta: (delta: number) => void;\n\n  refreshUserId: () => void;\n\n}\n\n\n\nconst UserContext = createContext<UserContextType | undefined>(undefined);\n\n\n\nfunction resolveUserId(firebaseUser: User | null): string {\n\n  const localId = getLocalProfileUserId();\n\n  if (localId) return localId;\n\n  if (firebaseUser?.uid) return firebaseUser.uid;\n\n  if (firebaseUser?.email) return firebaseUser.email;\n\n  return 'anonim_user_id';\n\n}\n\n\n\nfunction resolveDisplayName(firebaseUser: User | null): string {\n\n  if (firebaseUser?.displayName) return firebaseUser.displayName;\n\n  if (firebaseUser?.email) return firebaseUser.email;\n\n  return getLocalProfileDisplayName();\n\n}\n\n\n\nexport function UserProvider({ children }: { children: React.ReactNode }) {\n\n  const [user, setUser] = useState<User | null>(null);\n\n  const [userId, setUserId] = useState('anonim_user_id');\n\n  const [manat, setManat] = useState(0);\n\n  const [manatReady, setManatReady] = useState(false);\n\n  const [playerProfile, setPlayerProfile] = useState<PlayerProfile | null>(null);\n\n  const [profileReady, setProfileReady] = useState(false);\n\n  const pendingManatDeltaRef = useRef(0);\n\n\n\n  const refreshUserId = useCallback(() => {\n\n    setUserId(resolveUserId(user));\n\n  }, [user]);\n\n\n\n  const applyManatDelta = useCallback((delta: number) => {\n\n    if (!delta) return;\n\n    pendingManatDeltaRef.current += delta;\n\n    setManat((prev) => Math.max(0, prev + delta));\n\n  }, []);\n\n\n\n  useEffect(() => {\n\n    clearLegacyBalanceStorage();\n\n    void ensureFirebaseAuth();\n\n\n\n    const applyId = () => {\n\n      const localId = getLocalProfileUserId();\n\n      if (localId) setUserId(localId);\n\n    };\n\n\n\n    applyId();\n\n    window.addEventListener('gesbx_user_updated', applyId);\n\n    window.addEventListener('storage', applyId);\n\n\n\n    const unsubscribe = onAuthStateChanged(auth, (firebaseUser) => {\n\n      setUser(firebaseUser);\n\n      const localId = getLocalProfileUserId();\n\n      setUserId(localId || resolveUserId(firebaseUser));\n\n    });\n\n\n\n    return () => {\n\n      unsubscribe();\n\n      window.removeEventListener('gesbx_user_updated', applyId);\n\n      window.removeEventListener('storage', applyId);\n\n    };\n\n  }, []);\n\n\n\n  useEffect(() => {\n\n    if (!userId || userId === 'anonim_user_id') {\n\n      setManat(0);\n\n      setManatReady(true);\n\n      setProfileReady(true);\n\n      return;\n\n    }\n\n\n\n    setManatReady(false);\n\n    const displayName = resolveDisplayName(user);\n\n    let cancelled = false;\n\n\n\n    void ensurePlayerProfile(userId, displayName, user?.uid ?? null).then(() => {\n\n      if (!cancelled) setProfileReady(true);\n\n    });\n\n\n\n    const ref = doc(db, 'players', userId);\n\n    const unsub = onSnapshot(\n\n      ref,\n\n      (snap) => {\n\n        if (snap.exists()) {\n\n          const raw = snap.data() as Record<string, unknown>;\n\n          const nextManat = resolvePlayerManat(raw);\n\n          setPlayerProfile({ ...(raw as unknown as PlayerProfile), odId: userId, manat: nextManat });\n\n          pendingManatDeltaRef.current = 0;\n\n          setManat(nextManat);\n\n        } else {\n\n          setPlayerProfile(null);\n\n          pendingManatDeltaRef.current = 0;\n\n          setManat(0);\n\n        }\n\n        setManatReady(true);\n\n      },\n\n      (err) => {\n\n        console.error('Firebase players dinləyicisi xətası:', err);\n\n        setManatReady(true);\n\n      }\n\n    );\n\n\n\n    return () => {\n\n      cancelled = true;\n\n      unsub();\n\n    };\n\n  }, [userId, user?.displayName, user?.email, user?.uid]);\n\n\n\n  useEffect(() => {\n\n    if (!userId || userId === 'anonim_user_id') return;\n\n    if (!user?.uid || user.uid === userId) return;\n\n\n\n    const reconcileKey = `player_reconciled_${userId}_${user.uid}`;\n\n    if (typeof window !== 'undefined' && sessionStorage.getItem(reconcileKey) === '1') return;\n\n\n\n    void reconcilePlayerIdentity(userId, user.uid, resolveDisplayName(user)).then(() => {\n\n      if (typeof window !== 'undefined') sessionStorage.setItem(reconcileKey, '1');\n\n    });\n\n  }, [userId, user?.uid, user?.displayName, user?.email]);\n\n\n\n  const addManat = useCallback(\n\n    async (amount: number) => {\n\n      if (amount <= 0 || !userId || userId === 'anonim_user_id') return;\n\n      applyManatDelta(amount);\n\n      const ref = doc(db, 'players', userId);\n\n      try {\n\n        await runTransaction(db, async (tx) => {\n\n          const snap = await tx.get(ref);\n\n          const current = snap.exists()\n\n            ? resolvePlayerManat(snap.data() as Record<string, unknown>)\n\n            : 0;\n\n          tx.set(ref, { ...manatWritePatch(current + amount), updatedAt: Date.now() }, { merge: true });\n\n        });\n\n      } catch (err) {\n\n        applyManatDelta(-amount);\n\n        throw err;\n\n      }\n\n    },\n\n    [userId, applyManatDelta]\n\n  );\n\n\n\n  const spendManat = useCallback(\n\n    async (amount: number) => {\n\n      if (amount <= 0 || !userId || userId === 'anonim_user_id') return false;\n\n      applyManatDelta(-amount);\n\n      const ref = doc(db, 'players', userId);\n\n      try {\n\n        await runTransaction(db, async (tx) => {\n\n          const snap = await tx.get(ref);\n\n          const current = snap.exists()\n\n            ? resolvePlayerManat(snap.data() as Record<string, unknown>)\n\n            : 0;\n\n          if (current < amount) throw new Error('insufficient');\n\n          tx.set(ref, { ...manatWritePatch(current - amount), updatedAt: Date.now() }, { merge: true });\n\n        });\n\n        return true;\n\n      } catch {\n\n        applyManatDelta(amount);\n\n        return false;\n\n      }\n\n    },\n\n    [userId, applyManatDelta]\n\n  );\n\n\n\n  const value: UserContextType = {\n\n    user,\n\n    userId,\n\n    manat,\n\n    manatReady,\n\n    playerProfile,\n\n    addManat,\n\n    spendManat,\n\n    applyManatDelta,\n\n    refreshUserId,\n\n  };\n\n\n\n  if (!profileReady && userId !== 'anonim_user_id') {\n\n    return <UserContext.Provider value={value}>{children}</UserContext.Provider>;\n\n  }\n\n\n\n  return <UserContext.Provider value={value}>{children}</UserContext.Provider>;\n\n}\n\n\n\nexport function useUser() {\n\n  const context = useContext(UserContext);\n\n  if (!context) {\n\n    throw new Error('useUser must be used within a UserProvider');\n\n  }\n\n  return context;\n\n}\n\n\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Lenovo\\Downloads\\gbesx\\GESBX\\eslint.config.mjs","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Lenovo\\Downloads\\gbesx\\GESBX\\firebase.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Lenovo\\Downloads\\gbesx\\GESBX\\functions\\index.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Lenovo\\Downloads\\gbesx\\GESBX\\functions\\src\\account.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Lenovo\\Downloads\\gbesx\\GESBX\\functions\\src\\admin.js","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'uid' is defined but never used.","line":232,"column":33,"nodeType":"Identifier","messageId":"unusedVar","endLine":232,"endColumn":36}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"const { z } = require('zod');\nconst {\n  db,\n  FieldValue,\n  HttpsError,\n  secureCallable,\n  operationDocId,\n  ensureRateLimitTx,\n  adminUid,\n  storedManat,\n} = require('./security');\n\nconst ADMIN_PROFILE_ID = '1';\nconst playerIdSchema = z.string().regex(/^\\d{1,20}$/);\nconst bootstrapSchema = z.object({ displayName: z.string().trim().min(2).max(100) }).strict();\nconst sessionSchema = z.object({ displayName: z.string().trim().max(100).optional(), active: z.boolean() }).strict();\n\nfunction splitName(displayName) {\n  const parts = String(displayName || '').trim().split(/\\s+/).filter(Boolean);\n  return {\n    name: parts[0] || 'Admin',\n    surname: parts.slice(1).join(' '),\n  };\n}\n\nasync function bootstrapSuperAdmin({ uid, payload, operationId, rateLimit, authToken }) {\n  if (!adminUid(uid)) throw new HttpsError('permission-denied', 'Admin icazəsi tələb olunur.');\n  const userRef = db.doc(`users/${ADMIN_PROFILE_ID}`);\n  const playerRef = db.doc(`players/${ADMIN_PROFILE_ID}`);\n  const configRef = db.doc('app_config/admin');\n  const counterRef = db.doc('counters/userIdCounter');\n  const sessionRef = db.doc(`admin_sessions/${ADMIN_PROFILE_ID}`);\n  const opRef = db.doc(`operation_ledger/${operationDocId(uid, operationId)}`);\n  const commandRef = db.doc(`admin_commands/${operationDocId(uid, operationId)}`);\n  const now = Date.now();\n  const names = splitName(payload.displayName);\n\n  return db.runTransaction(async (tx) => {\n    const operation = await tx.get(opRef);\n    if (operation.exists) return operation.data().result;\n    const rate = await ensureRateLimitTx(tx, uid, 'bootstrapSuperAdmin', rateLimit, now);\n    const [userSnap, playerSnap, configSnap, counterSnap] = await Promise.all([\n      tx.get(userRef), tx.get(playerRef), tx.get(configRef), tx.get(counterRef),\n    ]);\n    if (userSnap.exists && userSnap.data().firebaseUid && userSnap.data().firebaseUid !== uid) {\n      throw new HttpsError('permission-denied', 'Admin profil ID-si başqa Firebase hesabına bağlıdır.');\n    }\n    if (playerSnap.exists && playerSnap.data().firebaseUid && playerSnap.data().firebaseUid !== uid) {\n      throw new HttpsError('permission-denied', 'Admin oyunçu ID-si başqa Firebase hesabına bağlıdır.');\n    }\n    const oldUser = userSnap.exists ? userSnap.data() : {};\n    const oldPlayer = playerSnap.exists ? playerSnap.data() : {};\n    const trustedPlayer = oldPlayer.identityVerifiedAt && oldPlayer.firebaseUid === uid;\n    const result = { userId: ADMIN_PROFILE_ID, active: true };\n    tx.set(userRef, {\n      id: ADMIN_PROFILE_ID,\n      ...names,\n      handle: oldUser.handle || '@admin',\n      role: 'super_admin',\n      isAdmin: true,\n      isModerator: true,\n      canViewReports: true,\n      canAccessAdminPanel: true,\n      firebaseUid: uid,\n      email: oldUser.email || authToken.email || null,\n      createdAt: oldUser.createdAt || now,\n      updatedAt: now,\n    }, { merge: true });\n    tx.set(playerRef, {\n      odId: ADMIN_PROFILE_ID,\n      firebaseUid: uid,\n      identityVerifiedAt: trustedPlayer ? oldPlayer.identityVerifiedAt : now,\n      displayName: payload.displayName,\n      allianceId: trustedPlayer ? (oldPlayer.allianceId || null) : null,\n      allianceName: trustedPlayer ? (oldPlayer.allianceName || null) : null,\n      isLeader: false,\n      manat: trustedPlayer ? storedManat(oldPlayer) : 0,\n      coins: trustedPlayer ? storedManat(oldPlayer) : 0,\n      xp: trustedPlayer ? Math.max(0, Math.floor(Number(oldPlayer.xp) || 0)) : 0,\n      battleCards: trustedPlayer ? oldPlayer.battleCards : { zombi: 0, yarasa: 0, duman: 0, mutant: 0, standing: 0, it: 0 },\n      activeShields: trustedPlayer && Array.isArray(oldPlayer.activeShields) ? oldPlayer.activeShields : [],\n      cosmetics: trustedPlayer && oldPlayer.cosmetics ? oldPlayer.cosmetics : { owned: [], equipped: {}, vip: { tier: 'none', expiresAt: 0 } },\n      userPlan: trustedPlayer ? (oldPlayer.userPlan || 'FREE') : 'FREE',\n      hasVipPass: trustedPlayer && oldPlayer.hasVipPass === true,\n      isVipLifetime: trustedPlayer && oldPlayer.isVipLifetime === true,\n      proPanelActive: trustedPlayer && oldPlayer.proPanelActive === true,\n      battleCardsVersion: 4,\n      updatedAt: now,\n    }, { merge: true });\n    if (!configSnap.exists) tx.create(configRef, { superAdminId: ADMIN_PROFILE_ID, minNewUserId: 2, updatedAt: now });\n    const currentId = counterSnap.exists ? Math.max(1, Math.floor(Number(counterSnap.data().currentId) || 1)) : 1;\n    tx.set(counterRef, { currentId: Math.max(1, currentId), reservedAdminId: ADMIN_PROFILE_ID, updatedAt: now }, { merge: true });\n    tx.set(sessionRef, { adminId: ADMIN_PROFILE_ID, adminUid: uid, displayName: payload.displayName, active: true, lastLoginAt: now }, { merge: true });\n    tx.create(commandRef, { adminId: ADMIN_PROFILE_ID, adminUid: uid, action: 'bootstrap_super_admin', details: {}, createdAt: now });\n    tx.create(opRef, { authUid: uid, operationId, action: 'bootstrapSuperAdmin', result, createdAt: FieldValue.serverTimestamp() });\n    tx.set(rate.ref, rate.next);\n    return result;\n  });\n}\n\nasync function recordAdminSession({ uid, payload, operationId, rateLimit }) {\n  if (!adminUid(uid)) throw new HttpsError('permission-denied', 'Admin icazəsi tələb olunur.');\n  const opRef = db.doc(`operation_ledger/${operationDocId(uid, operationId)}`);\n  const sessionRef = db.doc(`admin_sessions/${ADMIN_PROFILE_ID}`);\n  const commandRef = db.doc(`admin_commands/${operationDocId(uid, operationId)}`);\n  const now = Date.now();\n  return db.runTransaction(async (tx) => {\n    const operation = await tx.get(opRef);\n    if (operation.exists) return operation.data().result;\n    const rate = await ensureRateLimitTx(tx, uid, 'recordAdminSession', rateLimit, now);\n    const session = await tx.get(sessionRef);\n    const result = { active: payload.active };\n    tx.set(sessionRef, {\n      adminId: ADMIN_PROFILE_ID,\n      adminUid: uid,\n      ...(payload.displayName ? { displayName: payload.displayName } : {}),\n      active: payload.active,\n      ...(payload.active ? { lastLoginAt: now } : { lastLogoutAt: now }),\n    }, { merge: true });\n    tx.create(commandRef, {\n      adminId: ADMIN_PROFILE_ID,\n      adminUid: uid,\n      action: payload.active ? 'admin_login' : 'admin_logout',\n      details: payload.displayName ? { displayName: payload.displayName } : {},\n      createdAt: now,\n      wasActive: session.exists && session.data().active === true,\n    });\n    tx.create(opRef, { authUid: uid, operationId, action: 'recordAdminSession', result, createdAt: FieldValue.serverTimestamp() });\n    tx.set(rate.ref, rate.next);\n    return result;\n  });\n}\n\nasync function runAdminMutation(context, action, targetUserId, details, mutate) {\n  const { uid, operationId, rateLimit } = context;\n  if (!adminUid(uid)) throw new HttpsError('permission-denied', 'Admin icazəsi tələb olunur.');\n  const opRef = db.doc(`operation_ledger/${operationDocId(uid, operationId)}`);\n  const commandRef = db.doc(`admin_commands/${operationDocId(uid, operationId)}`);\n  const now = Date.now();\n  return db.runTransaction(async (tx) => {\n    const operation = await tx.get(opRef);\n    if (operation.exists) return operation.data().result;\n    const rate = await ensureRateLimitTx(tx, uid, action, rateLimit, now);\n    const result = await mutate(tx, now);\n    tx.create(commandRef, {\n      adminId: ADMIN_PROFILE_ID,\n      adminUid: uid,\n      action,\n      targetUserId: targetUserId || null,\n      details: details || {},\n      createdAt: now,\n    });\n    tx.create(opRef, { authUid: uid, operationId, action, result, createdAt: FieldValue.serverTimestamp() });\n    tx.set(rate.ref, rate.next);\n    return result;\n  });\n}\n\nasync function adminResolveReport(context) {\n  const reportRef = db.doc(`reports/${context.payload.reportId}`);\n  return runAdminMutation(context, 'resolve_report', undefined, { status: context.payload.status }, async (tx, now) => {\n    const report = await tx.get(reportRef);\n    if (!report.exists) throw new HttpsError('not-found', 'Şikayət tapılmadı.');\n    tx.update(reportRef, { status: context.payload.status, resolvedAt: now, resolvedBy: context.uid });\n    return { reportId: reportRef.id, status: context.payload.status };\n  });\n}\n\nasync function adminPunishUser(context) {\n  const userId = context.payload.targetUserId;\n  const userRef = db.doc(`users/${userId}`);\n  const playerRef = db.doc(`players/${userId}`);\n  const until = Date.now() + context.payload.days * 24 * 60 * 60 * 1000;\n  return runAdminMutation(context, 'punish_user', userId, { days: context.payload.days, reason: context.payload.reason, until }, async (tx, now) => {\n    const [user, player] = await Promise.all([tx.get(userRef), tx.get(playerRef)]);\n    if (!user.exists) throw new HttpsError('not-found', 'İstifadəçi tapılmadı.');\n    tx.update(userRef, { punishedUntil: until, punishReason: context.payload.reason, updatedAt: now, punishedBy: context.uid });\n    if (player.exists) tx.update(playerRef, { punishedUntil: until, updatedAt: now });\n    return { userId, punishedUntil: until };\n  });\n}\n\nasync function adminBanUser(context) {\n  const userId = context.payload.targetUserId;\n  const userRef = db.doc(`users/${userId}`);\n  const playerRef = db.doc(`players/${userId}`);\n  return runAdminMutation(context, context.payload.banned ? 'ban_user' : 'unban_user', userId, { banned: context.payload.banned }, async (tx, now) => {\n    const [user, player] = await Promise.all([tx.get(userRef), tx.get(playerRef)]);\n    if (!user.exists) throw new HttpsError('not-found', 'İstifadəçi tapılmadı.');\n    tx.update(userRef, { banned: context.payload.banned, updatedAt: now, bannedBy: context.payload.banned ? context.uid : null });\n    if (player.exists) tx.update(playerRef, { banned: context.payload.banned, updatedAt: now });\n    return { userId, banned: context.payload.banned };\n  });\n}\n\nasync function adminDeleteUser(context) {\n  const userId = context.payload.targetUserId;\n  if (userId === ADMIN_PROFILE_ID) throw new HttpsError('failed-precondition', 'Super admin silinə bilməz.');\n  const userRef = db.doc(`users/${userId}`);\n  const playerRef = db.doc(`players/${userId}`);\n  return runAdminMutation(context, 'delete_user', userId, {}, async (tx) => {\n    const [user, player] = await Promise.all([tx.get(userRef), tx.get(playerRef)]);\n    if (!user.exists) throw new HttpsError('not-found', 'İstifadəçi tapılmadı.');\n    tx.delete(userRef);\n    if (player.exists) tx.delete(playerRef);\n    return { userId, deleted: true };\n  });\n}\n\nasync function adminGrantModerator(context) {\n  const userId = context.payload.targetUserId;\n  const userRef = db.doc(`users/${userId}`);\n  return runAdminMutation(context, context.payload.grant ? 'grant_moderator' : 'revoke_moderator', userId, { grant: context.payload.grant }, async (tx, now) => {\n    const user = await tx.get(userRef);\n    if (!user.exists) throw new HttpsError('not-found', 'İstifadəçi tapılmadı.');\n    tx.update(userRef, {\n      isModerator: context.payload.grant,\n      canViewReports: context.payload.grant,\n      updatedAt: now,\n      moderatorBy: context.payload.grant ? context.uid : null,\n    });\n    return { userId, isModerator: context.payload.grant };\n  });\n}\n\nconst reportSchema = z.object({ reportId: z.string().min(6).max(120), status: z.enum(['resolved', 'dismissed']) }).strict();\nconst punishSchema = z.object({ targetUserId: playerIdSchema, days: z.number().int().min(1).max(365), reason: z.string().trim().min(1).max(500) }).strict();\nconst banSchema = z.object({ targetUserId: playerIdSchema, banned: z.boolean() }).strict();\nconst deleteSchema = z.object({ targetUserId: playerIdSchema }).strict();\nconst moderatorSchema = z.object({ targetUserId: playerIdSchema, grant: z.boolean() }).strict();\n\nasync function allocateUserId({ uid }) {\n  const counterRef = db.doc('counters/userIdCounter');\n  const configRef = db.doc('app_config/admin');\n  return db.runTransaction(async (tx) => {\n    const [counterSnap, configSnap] = await Promise.all([tx.get(counterRef), tx.get(configRef)]);\n    let candidate = Math.max(2, Number(counterSnap.data()?.currentId || 1) + 1,\n      Number(configSnap.data()?.minNewUserId || 2));\n    for (let attempt = 0; attempt < 100; attempt += 1, candidate += 1) {\n      const [userSnap, playerSnap] = await Promise.all([\n        tx.get(db.doc(`users/${candidate}`)), tx.get(db.doc(`players/${candidate}`)),\n      ]);\n      if (userSnap.exists || playerSnap.exists) continue;\n      tx.set(counterRef, { currentId: candidate, reservedAdminId: ADMIN_PROFILE_ID, updatedAt: Date.now() }, { merge: true });\n      return { userId: String(candidate) };\n    }\n    throw new HttpsError('resource-exhausted', 'İstifadəçi ID-si ayrıla bilmədi.');\n  });\n}\n\nexports.allocateUserId = secureCallable(\n  'allocateUserId', z.object({}).strict(), allocateUserId, { max: 10, windowMs: 60_000 },\n);\n\nexports.bootstrapSuperAdmin = secureCallable(\n  'bootstrapSuperAdmin', bootstrapSchema, bootstrapSuperAdmin, { max: 5, windowMs: 60_000 },\n);\nexports.recordAdminSession = secureCallable(\n  'recordAdminSession', sessionSchema, recordAdminSession, { max: 30, windowMs: 60_000 },\n);\nexports.adminResolveReport = secureCallable('adminResolveReport', reportSchema, adminResolveReport, { max: 60, windowMs: 60_000 });\nexports.adminPunishUser = secureCallable('adminPunishUser', punishSchema, adminPunishUser, { max: 30, windowMs: 60_000 });\nexports.adminBanUser = secureCallable('adminBanUser', banSchema, adminBanUser, { max: 30, windowMs: 60_000 });\nexports.adminDeleteUser = secureCallable('adminDeleteUser', deleteSchema, adminDeleteUser, { max: 10, windowMs: 60_000 });\nexports.adminGrantModerator = secureCallable('adminGrantModerator', moderatorSchema, adminGrantModerator, { max: 30, windowMs: 60_000 });\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Lenovo\\Downloads\\gbesx\\GESBX\\functions\\src\\allianceBattles.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Lenovo\\Downloads\\gbesx\\GESBX\\functions\\src\\alliances.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Lenovo\\Downloads\\gbesx\\GESBX\\functions\\src\\appCheck.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Lenovo\\Downloads\\gbesx\\GESBX\\functions\\src\\arenaRewards.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Lenovo\\Downloads\\gbesx\\GESBX\\functions\\src\\economy.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Lenovo\\Downloads\\gbesx\\GESBX\\functions\\src\\identity.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Lenovo\\Downloads\\gbesx\\GESBX\\functions\\src\\reels.js","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'userSchema' is assigned a value but never used.","line":17,"column":7,"nodeType":"Identifier","messageId":"unusedVar","endLine":17,"endColumn":17}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"const crypto = require('node:crypto');\nconst { z } = require('zod');\nconst {\n  db,\n  FieldValue,\n  HttpsError,\n  secureCallable,\n  operationDocId,\n  getOwnedPlayer,\n  readOperation,\n  ensureRateLimitTx,\n  writeXpLedger,\n  storedXp,\n} = require('./security');\n\nconst idSchema = z.string().regex(/^\\d{1,20}$/);\nconst userSchema = z.object({ userId: idSchema }).strict();\nconst startSchema = z.object({ userId: idSchema, videoId: z.string().min(1).max(180) }).strict();\nconst heartbeatSchema = z.object({ userId: idSchema, sessionId: z.string().min(12).max(100) }).strict();\nconst completeSchema = z.object({\n  userId: idSchema,\n  sessionId: z.string().min(12).max(100),\n  playedSeconds: z.number().finite().min(0).max(3600),\n}).strict();\n\nfunction uidKey(uid) {\n  return crypto.createHash('sha256').update(uid).digest('hex').slice(0, 32);\n}\n\nfunction startReelRewardViewHandler({ uid, payload, operationId, rateLimit }) {\n  const sessionId = operationDocId(uid, `reel-start:${operationId}`);\n  const sessionRef = db.doc(`reel_view_sessions/${sessionId}`);\n  const postRef = db.doc(`posts/${payload.videoId}`);\n  const now = Date.now();\n  return db.runTransaction(async (tx) => {\n    const existing = await tx.get(sessionRef);\n    if (existing.exists) return { sessionId, startedAt: existing.data().startedAt };\n    const rate = await ensureRateLimitTx(tx, uid, 'startReelRewardView', rateLimit, now);\n    const owned = await getOwnedPlayer(uid, payload.userId, tx);\n    const postSnap = await tx.get(postRef);\n    if (!postSnap.exists) throw new HttpsError('not-found', 'Video tapılmadı.');\n    const post = postSnap.data();\n    if (String(post.userId) === owned.playerId) throw new HttpsError('failed-precondition', 'Öz videona baxış üçün XP verilmir.');\n    const duration = Number(post.durationSeconds ?? post.videoDurationSeconds);\n    if (post.mediaType !== 'video' || !Number.isFinite(duration) || duration < 5 || duration > 3600) {\n      throw new HttpsError('failed-precondition', 'Videonun uzunluğu təsdiqlənmir.');\n    }\n    tx.create(sessionRef, {\n      authUid: uid,\n      playerId: owned.playerId,\n      videoId: payload.videoId,\n      durationSeconds: duration,\n      startedAt: now,\n      heartbeatCount: 0,\n      lastHeartbeatAt: 0,\n      status: 'watching',\n      expiresAt: now + 24 * 60 * 60 * 1000,\n      createdAt: FieldValue.serverTimestamp(),\n    });\n    tx.set(rate.ref, rate.next);\n    return { sessionId, startedAt: now, durationSeconds: duration };\n  });\n}\n\nfunction heartbeatReelRewardViewHandler({ uid, payload, rateLimit }) {\n  const sessionRef = db.doc(`reel_view_sessions/${payload.sessionId}`);\n  const now = Date.now();\n  return db.runTransaction(async (tx) => {\n    const rate = await ensureRateLimitTx(tx, uid, 'heartbeatReelRewardView', rateLimit, now);\n    const sessionSnap = await tx.get(sessionRef);\n    if (!sessionSnap.exists || sessionSnap.data().authUid !== uid) throw new HttpsError('not-found', 'Baxış sessiyası tapılmadı.');\n    const session = sessionSnap.data();\n    if (session.status !== 'watching') throw new HttpsError('failed-precondition', 'Baxış sessiyası artıq aktiv deyil.');\n    if (now - Number(session.startedAt) > Math.max(180_000, Number(session.durationSeconds) * 4_000)) {\n      throw new HttpsError('deadline-exceeded', 'Baxış sessiyasının vaxtı bitib.');\n    }\n    const elapsed = now - Number(session.lastHeartbeatAt || session.startedAt);\n    if (elapsed < 4_000) {\n      tx.set(rate.ref, rate.next);\n      return { heartbeatCount: Number(session.heartbeatCount) || 0, accepted: false };\n    }\n    const nextCount = Math.min(240, (Number(session.heartbeatCount) || 0) + 1);\n    tx.update(sessionRef, { heartbeatCount: nextCount, lastHeartbeatAt: now, updatedAt: FieldValue.serverTimestamp() });\n    tx.set(rate.ref, rate.next);\n    return { heartbeatCount: nextCount, accepted: true };\n  });\n}\n\nfunction completeReelRewardViewHandler({ uid, payload, operationId, rateLimit }) {\n  const sessionRef = db.doc(`reel_view_sessions/${payload.sessionId}`);\n  const now = Date.now();\n  const dayKey = new Date(now).toISOString().slice(0, 10);\n  const dailyRef = db.doc(`reel_reward_daily/${uidKey(uid)}_${dayKey}`);\n  const completionRef = db.doc(`reel_reward_views/${operationDocId(uid, `${payload.sessionId}:${dayKey}`)}`);\n\n  return db.runTransaction(async (tx) => {\n    const xpLedger = await readOperation(tx, uid, operationId, 'xp_ledger');\n    if (xpLedger.data) return xpLedger.data.result;\n    const rate = await ensureRateLimitTx(tx, uid, 'completeReelRewardView', rateLimit, now);\n    const sessionSnap = await tx.get(sessionRef);\n    if (!sessionSnap.exists || sessionSnap.data().authUid !== uid) throw new HttpsError('not-found', 'Baxış sessiyası tapılmadı.');\n    const session = sessionSnap.data();\n    const owned = await getOwnedPlayer(uid, payload.userId, tx);\n    const [dailySnap, completedSnap] = await Promise.all([tx.get(dailyRef), tx.get(completionRef)]);\n    if (session.playerId !== owned.playerId) throw new HttpsError('permission-denied', 'Baxış sessiyası bu oyunçuya aid deyil.');\n    if (completedSnap.exists || session.status === 'completed') {\n      const duplicateResult = { xp: 0, dailyXp: Number(dailySnap.data()?.earnedXp) || 0, duplicate: true };\n      tx.set(rate.ref, rate.next);\n      return duplicateResult;\n    }\n    if (session.status !== 'watching') throw new HttpsError('failed-precondition', 'Baxış sessiyası etibarlı deyil.');\n\n    const elapsedSeconds = (now - Number(session.startedAt)) / 1000;\n    const videoSeconds = Number(session.durationSeconds);\n    const playedSeconds = Number(payload.playedSeconds);\n    const requiredSeconds = Math.min(videoSeconds, Math.max(5, videoSeconds * 0.7));\n    const requiredHeartbeats = Math.max(1, Math.floor(requiredSeconds / 8));\n    if (elapsedSeconds + 1 < requiredSeconds || playedSeconds < requiredSeconds || playedSeconds > elapsedSeconds + 3) {\n      throw new HttpsError('failed-precondition', 'Video minimum izlənmə müddəti tamamlanmayıb.');\n    }\n    if ((Number(session.heartbeatCount) || 0) < requiredHeartbeats) {\n      throw new HttpsError('failed-precondition', 'Video baxış fəaliyyəti təsdiqlənmədi.');\n    }\n    if (elapsedSeconds > Math.max(180, videoSeconds * 4)) {\n      throw new HttpsError('deadline-exceeded', 'Baxış sessiyasının vaxtı bitib.');\n    }\n\n    const dailyXp = dailySnap.exists ? Math.max(0, Number(dailySnap.data().earnedXp) || 0) : 0;\n    const xpModeDisabled = owned.player.proPanelActive === true;\n    const award = xpModeDisabled || dailyXp >= 500 ? 0 : Math.min(1, 500 - dailyXp);\n    if (award === 0) {\n      const result = { xp: 0, dailyXp, capped: dailyXp >= 500, xpModeDisabled };\n      tx.update(sessionRef, { status: 'completed', completedAt: now, updatedAt: FieldValue.serverTimestamp() });\n      tx.create(completionRef, { authUid: uid, playerId: owned.playerId, videoId: session.videoId, dateKey: dayKey, xp: 0, createdAt: FieldValue.serverTimestamp() });\n      tx.set(rate.ref, rate.next);\n      return result;\n    }\n\n    const nextXp = storedXp(owned.player) + award;\n    const nextDailyXp = dailyXp + award;\n    const result = { xp: award, dailyXp: nextDailyXp, capped: nextDailyXp >= 500 };\n    tx.update(sessionRef, { status: 'completed', completedAt: now, updatedAt: FieldValue.serverTimestamp() });\n    tx.create(completionRef, { authUid: uid, playerId: owned.playerId, videoId: session.videoId, dateKey: dayKey, xp: award, createdAt: FieldValue.serverTimestamp() });\n    tx.set(dailyRef, { authUid: uid, dateKey: dayKey, earnedXp: nextDailyXp, updatedAt: FieldValue.serverTimestamp() }, { merge: true });\n    tx.set(owned.playerRef, { xp: nextXp, updatedAt: now }, { merge: true });\n    writeXpLedger(tx, xpLedger.ref, {\n      uid, playerId: owned.playerId, operationId, type: 'reel_view', amount: award,\n      xpAfter: nextXp, source: session.videoId, result,\n    });\n    tx.set(rate.ref, rate.next);\n    return result;\n  });\n}\n\nconst startReelRewardView = secureCallable('startReelRewardView', startSchema, startReelRewardViewHandler, { max: 20, windowMs: 60_000 });\nconst heartbeatReelRewardView = secureCallable('heartbeatReelRewardView', heartbeatSchema, heartbeatReelRewardViewHandler, { max: 20, windowMs: 60_000 });\nconst completeReelRewardView = secureCallable('completeReelRewardView', completeSchema, completeReelRewardViewHandler, { max: 20, windowMs: 60_000 });\n\nmodule.exports = { startReelRewardView, heartbeatReelRewardView, completeReelRewardView };\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Lenovo\\Downloads\\gbesx\\GESBX\\functions\\src\\referrals.js","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'ip' is defined but never used.","line":193,"column":80,"nodeType":"Identifier","messageId":"unusedVar","endLine":193,"endColumn":82},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'ip' is defined but never used.","line":271,"column":71,"nodeType":"Identifier","messageId":"unusedVar","endLine":271,"endColumn":73}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"const crypto = require('node:crypto');\nconst { z } = require('zod');\nconst {\n  db,\n  FieldValue,\n  HttpsError,\n  secureCallable,\n  operationDocId,\n  getOwnedPlayer,\n  ensureRateLimitTx,\n  writeXpLedger,\n  storedXp,\n  adminUid,\n  riskHash,\n  RISK_HASH_SECRET,\n  REFERRAL_CODE_SECRET,\n} = require('./security');\n\nconst playerIdSchema = z.string().regex(/^\\d{1,20}$/);\nconst codeSchema = z.string().trim().min(6).max(20).transform((value) => value.toUpperCase());\nconst getCodeSchema = z.object({ userId: playerIdSchema, installationId: z.string().min(8).max(160).optional() }).strict();\nconst applySchema = z.object({ userId: playerIdSchema, code: codeSchema, installationId: z.string().min(8).max(160).optional() }).strict();\nconst reviewSchema = z.object({ referralId: z.string().min(12).max(100), decision: z.enum(['approve', 'reject']), note: z.string().trim().max(500).optional() }).strict();\nconst checkActivationSchema = z.object({ referralId: z.string().min(12).max(100) }).strict();\nconst getMyReferralsSchema = z.object({ userId: playerIdSchema }).strict();\nconst REFERRAL_XP_THRESHOLD = 6500;\nconst REFERRAL_REWARD_XP = 6500;\n\nfunction referralCode(uid) {\n  const salt = String(REFERRAL_CODE_SECRET.value() || RISK_HASH_SECRET.value() || '').trim();\n  if (!salt) throw new HttpsError('failed-precondition', 'Referral kodu üçün REFERRAL_CODE_SECRET təyin edilməlidir.');\n  return crypto.createHmac('sha256', salt).update(`referral:${uid}`).digest('hex').slice(0, 10).toUpperCase();\n}\n\nasync function getMyReferralCode({ uid, payload, operationId, rateLimit, ip }) {\n  const code = referralCode(uid);\n  const codeRef = db.doc(`referral_codes/${code}`);\n  const operationRef = db.doc(`operation_ledger/${operationDocId(uid, operationId)}`);\n  const now = Date.now();\n  const ipHash = riskHash(ip, 'ip');\n  const installationHash = riskHash(payload.installationId, 'installation');\n  return db.runTransaction(async (tx) => {\n    const operationSnap = await tx.get(operationRef);\n    if (operationSnap.exists) return operationSnap.data().result;\n    const rate = await ensureRateLimitTx(tx, uid, 'getMyReferralCode', rateLimit, now);\n    const owned = await getOwnedPlayer(uid, payload.userId, tx);\n    const existing = await tx.get(codeRef);\n    if (existing.exists && existing.data().authUid !== uid) throw new HttpsError('already-exists', 'Referral kodu toqquşması baş verdi.');\n    tx.set(codeRef, {\n      authUid: uid,\n      playerId: owned.playerId,\n      installationHash: installationHash || null,\n      ipHash: ipHash || null,\n      createdAt: existing.exists ? existing.data().createdAt : FieldValue.serverTimestamp(),\n      updatedAt: FieldValue.serverTimestamp(),\n    }, { merge: true });\n    const result = { code };\n    tx.create(operationRef, { authUid: uid, operationId, action: 'getMyReferralCode', result, createdAt: FieldValue.serverTimestamp() });\n    tx.set(rate.ref, rate.next);\n    return result;\n  });\n}\n\nasync function applyReferral({ uid, authToken, payload, operationId, rateLimit, ip }) {\n  if (authToken.email_verified !== true) throw new HttpsError('failed-precondition', 'Referral üçün təsdiqlənmiş email tələb olunur.');\n  const code = payload.code;\n  const codeRef = db.doc(`referral_codes/${code}`);\n  const referralRef = db.doc(`referrals/${operationDocId(uid, 'one-referral')}`);\n  const operationRef = db.doc(`operation_ledger/${operationDocId(uid, operationId)}`);\n  const now = Date.now();\n  const dayKey = new Date(now).toISOString().slice(0, 10);\n  const inviterLimitRef = db.doc(`referral_daily_limits/${operationDocId(code, dayKey)}`);\n  const ipHash = riskHash(ip, 'ip');\n  const installationHash = riskHash(payload.installationId, 'installation');\n\n  return db.runTransaction(async (tx) => {\n    const operationSnap = await tx.get(operationRef);\n    if (operationSnap.exists) return operationSnap.data().result;\n    const rate = await ensureRateLimitTx(tx, uid, 'applyReferral', rateLimit, now);\n    const referred = await getOwnedPlayer(uid, payload.userId, tx);\n    const [codeSnap, priorReferral, inviterLimitSnap] = await Promise.all([\n      tx.get(codeRef), tx.get(referralRef), tx.get(inviterLimitRef),\n    ]);\n    if (!codeSnap.exists) throw new HttpsError('not-found', 'Referral kodu tapılmadı.');\n    if (priorReferral.exists) throw new HttpsError('already-exists', 'Bu hesab artıq referral ilə qeydiyyatdan keçib.');\n    const inviter = codeSnap.data();\n    if (inviter.authUid === uid || inviter.playerId === referred.playerId) {\n      throw new HttpsError('failed-precondition', 'Öz referral kodundan istifadə edə bilməzsən.');\n    }\n    const inviterRefs = [\n      db.doc(`players/${inviter.playerId}`),\n      db.doc(`users/${inviter.playerId}`),\n    ];\n    const [inviterPlayer, inviterUser] = await Promise.all(inviterRefs.map((ref) => tx.get(ref)));\n    if (!inviterPlayer.exists || !inviterUser.exists || inviterPlayer.data().firebaseUid !== inviter.authUid || inviterUser.data().firebaseUid !== inviter.authUid) {\n      throw new HttpsError('failed-precondition', 'Dəvət edən hesab təsdiqlənmir.');\n    }\n    const dailyCount = inviterLimitSnap.exists ? Number(inviterLimitSnap.data().count) || 0 : 0;\n    if (dailyCount >= 5) throw new HttpsError('resource-exhausted', 'Dəvət edən hesabın gündəlik referral limiti dolub.');\n\n    const riskFlags = [];\n    if (!RISK_HASH_SECRET.value()) riskFlags.push('risk_hash_secret_missing');\n    if (ipHash && inviter.ipHash && ipHash === inviter.ipHash) riskFlags.push('shared_ip');\n    if (installationHash && inviter.installationHash && installationHash === inviter.installationHash) riskFlags.push('shared_installation');\n    const result = { referralId: referralRef.id, status: 'pending', xpThreshold: REFERRAL_XP_THRESHOLD };\n    tx.create(referralRef, {\n      inviterUid: inviter.authUid,\n      inviterPlayerId: inviter.playerId,\n      referredUid: uid,\n      referredPlayerId: referred.playerId,\n      code,\n      dateKey: dayKey,\n      status: 'pending',\n      xpThreshold: REFERRAL_XP_THRESHOLD,\n      rewardXp: REFERRAL_REWARD_XP,\n      riskFlags,\n      ipHash,\n      installationHash,\n      createdAtMillis: now,\n      createdAt: FieldValue.serverTimestamp(),\n      activatedAt: null,\n    });\n    tx.set(inviterLimitRef, { count: dailyCount + 1, dateKey: dayKey, updatedAt: FieldValue.serverTimestamp() }, { merge: true });\n    tx.create(operationRef, { authUid: uid, operationId, action: 'applyReferral', result, createdAt: FieldValue.serverTimestamp() });\n    tx.set(rate.ref, rate.next);\n    return result;\n  });\n}\n\nasync function reviewReferral({ uid, payload, operationId, rateLimit }) {\n  if (!adminUid(uid)) throw new HttpsError('permission-denied', 'Admin icazəsi tələb olunur.');\n  const referralRef = db.doc(`referrals/${payload.referralId}`);\n  const operationRef = db.doc(`operation_ledger/${operationDocId(uid, operationId)}`);\n  const now = Date.now();\n  return db.runTransaction(async (tx) => {\n    const operationSnap = await tx.get(operationRef);\n    if (operationSnap.exists) return operationSnap.data().result;\n    const rate = await ensureRateLimitTx(tx, uid, 'reviewReferral', rateLimit, now);\n    const referralSnap = await tx.get(referralRef);\n    if (!referralSnap.exists) throw new HttpsError('not-found', 'Referral qeydi tapılmadı.');\n    const referral = referralSnap.data();\n    if (referral.status !== 'pending_review') throw new HttpsError('failed-precondition', 'Referral artıq yoxlanılıb.');\n    if (payload.decision === 'approve' && now < Number(referral.eligibleAt)) {\n      throw new HttpsError('failed-precondition', 'Referral üçün 7 günlük gözləmə müddəti tamamlanmayıb.');\n    }\n\n    let playerRef = null;\n    let xpLedgerRef = null;\n    let result;\n    if (payload.decision === 'approve') {\n      playerRef = db.doc(`players/${referral.inviterPlayerId}`);\n      const userRef = db.doc(`users/${referral.inviterPlayerId}`);\n      const [playerSnap, userSnap] = await Promise.all([tx.get(playerRef), tx.get(userRef)]);\n      if (!playerSnap.exists || !userSnap.exists || playerSnap.data().firebaseUid !== referral.inviterUid || userSnap.data().firebaseUid !== referral.inviterUid) {\n        throw new HttpsError('failed-precondition', 'Mükafat alacaq hesab təsdiqlənmir.');\n      }\n      const deterministicId = `referral_${payload.referralId}`;\n      xpLedgerRef = db.doc(`xp_ledger/${operationDocId(referral.inviterUid, deterministicId)}`);\n      const previousXp = await tx.get(xpLedgerRef);\n      if (!previousXp.exists) {\n        const nextXp = storedXp(playerSnap.data()) + REFERRAL_XP;\n        result = { referralId: referralRef.id, status: 'approved', rewardXp: REFERRAL_XP };\n        tx.update(playerRef, { xp: nextXp, updatedAt: now });\n        writeXpLedger(tx, xpLedgerRef, {\n          uid: referral.inviterUid,\n          playerId: referral.inviterPlayerId,\n          operationId: deterministicId,\n          type: 'referral_reward',\n          amount: REFERRAL_XP,\n          xpAfter: nextXp,\n          source: payload.referralId,\n          result,\n        });\n      } else {\n        result = { referralId: referralRef.id, status: 'approved', rewardXp: 0, duplicate: true };\n      }\n    } else {\n      result = { referralId: referralRef.id, status: 'rejected', rewardXp: 0 };\n    }\n    tx.update(referralRef, {\n      status: result.status,\n      reviewedAt: now,\n      reviewerUid: uid,\n      reviewNote: payload.note || '',\n      rewardGrantedAt: result.status === 'approved' ? now : null,\n    });\n    tx.create(operationRef, { authUid: uid, operationId, action: 'reviewReferral', result, createdAt: FieldValue.serverTimestamp() });\n    tx.set(rate.ref, rate.next);\n    return result;\n  });\n}\n\nasync function checkReferralActivation({ uid, payload, operationId, rateLimit, ip }) {\n  const now = Date.now();\n  const referralRef = db.doc(`referrals/${payload.referralId}`);\n  const operationRef = db.doc(`operation_ledger/${operationDocId(uid, operationId)}`);\n\n  return db.runTransaction(async (tx) => {\n    const operationSnap = await tx.get(operationRef);\n    if (operationSnap.exists) return operationSnap.data().result;\n\n    const rate = await ensureRateLimitTx(tx, uid, 'checkReferralActivation', rateLimit, now);\n    const referralSnap = await tx.get(referralRef);\n    if (!referralSnap.exists) throw new HttpsError('not-found', 'Referral qeydi tapılmadı.');\n    const referral = referralSnap.data();\n\n    if (referral.inviterUid !== uid) throw new HttpsError('permission-denied', 'Bu referral sizin dəvətiniz deyil.');\n    if (referral.status === 'active') return { referralId: referralRef.id, status: 'active', alreadyActive: true };\n    if (referral.status === 'rejected') throw new HttpsError('failed-precondition', 'Referral rədd edilib.');\n\n    const referredPlayerRef = db.doc(`players/${referral.referredPlayerId}`);\n    const referredPlayerSnap = await tx.get(referredPlayerRef);\n    if (!referredPlayerSnap.exists) throw new HttpsError('not-found', 'Dəvət edilən Oyuncu tapılmadı.');\n\n    const referredXp = storedXp(referredPlayerSnap.data());\n    if (referredXp < REFERRAL_XP_THRESHOLD) {\n      return {\n        referralId: referralRef.id,\n        status: 'pending',\n        xpThreshold: REFERRAL_XP_THRESHOLD,\n        currentXp: referredXp,\n        progressPercent: Math.round((referredXp / REFERRAL_XP_THRESHOLD) * 100),\n        notActive: true,\n      };\n    }\n\n    const inviterPlayerRef = db.doc(`players/${referral.inviterPlayerId}`);\n    const inviterPlayerSnap = await tx.get(inviterPlayerRef);\n    if (!inviterPlayerSnap.exists) throw new HttpsError('not-found', 'Dəvət edən Oyuncu tapılmadı.');\n\n    const deterministicId = `referral_activate_${payload.referralId}`;\n    const xpLedgerRef = db.doc(`xp_ledger/${operationDocId(referral.inviterUid, deterministicId)}`);\n    const previousXp = await tx.get(xpLedgerRef);\n    if (previousXp.exists) {\n      return { referralId: referralRef.id, status: 'active', alreadyActive: true, duplicate: true };\n    }\n\n    const nextXp = storedXp(inviterPlayerSnap.data()) + REFERRAL_REWARD_XP;\n    const result = {\n      referralId: referralRef.id,\n      status: 'active',\n      rewardXp: REFERRAL_REWARD_XP,\n      xpAfter: nextXp,\n      activatedAt: now,\n    };\n\n    tx.update(inviterPlayerRef, { xp: nextXp, updatedAt: now });\n    writeXpLedger(tx, xpLedgerRef, {\n      uid: referral.inviterUid,\n      playerId: referral.inviterPlayerId,\n      operationId: deterministicId,\n      type: 'referral_reward',\n      amount: REFERRAL_REWARD_XP,\n      xpAfter: nextXp,\n      source: payload.referralId,\n      result,\n    });\n\n    tx.update(referralRef, {\n      status: 'active',\n      activatedAt: now,\n      activatedByUid: uid,\n    });\n\n    tx.create(operationRef, { authUid: uid, operationId, action: 'checkReferralActivation', result, createdAt: FieldValue.serverTimestamp() });\n    tx.set(rate.ref, rate.next);\n    return result;\n  });\n}\n\nasync function getMyReferrals({ uid, payload, operationId, rateLimit, ip }) {\n  const now = Date.now();\n  const operationRef = db.doc(`operation_ledger/${operationDocId(uid, operationId)}`);\n\n  return db.runTransaction(async (tx) => {\n    const operationSnap = await tx.get(operationRef);\n    if (operationSnap.exists) return operationSnap.data().result;\n\n    const rate = await ensureRateLimitTx(tx, uid, 'getMyReferrals', rateLimit, now);\n    const referralsSnap = await db.collection('referrals').where('inviterPlayerId', '==', payload.userId).get();\n    const referrals = [];\n    referralsSnap.forEach((doc) => {\n      referrals.push({ id: doc.id, ...doc.data() });\n    });\n\n    const enriched = await Promise.all(referrals.map(async (ref) => {\n      const referredSnap = await tx.get(db.doc(`players/${ref.referredPlayerId}`));\n      const referredXp = referredSnap.exists ? storedXp(referredSnap.data()) : 0;\n      return {\n        ...ref,\n        referredXp,\n        progressPercent: Math.round((referredXp / REFERRAL_XP_THRESHOLD) * 100),\n        isActive: ref.status === 'active',\n        isPending: ref.status === 'pending',\n        rewardEarned: ref.status === 'active' ? Number(ref.rewardXp || 0) : 0,\n      };\n    }));\n\n    enriched.sort((a, b) => (b.createdAtMillis || 0) - (a.createdAtMillis || 0));\n\n    const totalEarnings = enriched.filter((r) => r.isActive).reduce((sum, r) => sum + r.rewardEarned, 0);\n    const activeCount = enriched.filter((r) => r.isActive).length;\n    const pendingCount = enriched.filter((r) => r.isPending).length;\n\n    const result = {\n      referrals: enriched,\n      totalEarnings,\n      activeCount,\n      pendingCount,\n      xpThreshold: REFERRAL_XP_THRESHOLD,\n    };\n\n    tx.create(operationRef, { authUid: uid, operationId, action: 'getMyReferrals', result, createdAt: FieldValue.serverTimestamp() });\n    tx.set(rate.ref, rate.next);\n    return result;\n  });\n}\n\nconst getMyReferralCodeCallable = secureCallable('getMyReferralCode', getCodeSchema, getMyReferralCode, { max: 10, windowMs: 60_000 });\nconst applyReferralCallable = secureCallable('applyReferral', applySchema, applyReferral, { max: 3, windowMs: 24 * 60 * 60 * 1000 });\nconst reviewReferralCallable = secureCallable('reviewReferral', reviewSchema, reviewReferral, { max: 30, windowMs: 60_000 });\nconst checkReferralActivationCallable = secureCallable('checkReferralActivation', checkActivationSchema, checkReferralActivation, { max: 10, windowMs: 60_000 });\nconst getMyReferralsCallable = secureCallable('getMyReferrals', getMyReferralsSchema, getMyReferrals, { max: 10, windowMs: 60_000 });\n\nmodule.exports = {\n  getMyReferralCode: getMyReferralCodeCallable,\n  applyReferral: applyReferralCallable,\n  reviewReferral: reviewReferralCallable,\n  checkReferralActivation: checkReferralActivationCallable,\n  getMyReferrals: getMyReferralsCallable,\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Lenovo\\Downloads\\gbesx\\GESBX\\functions\\src\\security.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\