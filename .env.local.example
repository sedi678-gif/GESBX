# Environment variables for Yolustu application
# See: https://github.com/yolustu-123/Yolustu-main

# ===== ZEGO (Real-time Audio/Video) =====
NEXT_PUBLIC_ZEGO_APP_ID=your_zego_app_id_here
NEXT_PUBLIC_ZEGO_APP_SIGN=your_zego_app_sign_here
# Set ZEGO_SERVER_SECRET with Firebase Secret Manager; never expose it to the web bundle.

# ===== FIREBASE =====
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# ===== MONGODB =====
MONGO_URI=mongodb://127.0.0.1:27017/yolustu

# ===== APP SETTINGS =====
PORT=4000
NODE_ENV=development
