# Local web-app settings. Keep service secrets in Firebase Secret Manager.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id
NEXT_PUBLIC_ZEGO_APP_ID=your_zego_app_id
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Standalone Socket.IO server settings (do not expose server-only values as NEXT_PUBLIC_*).
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_API_KEY=your_firebase_web_api_key

# Set ZEGO_SERVER_SECRET, ADMIN_UIDS, RISK_HASH_SECRET, REFERRAL_CODE_SECRET with Secret Manager.
