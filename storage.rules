rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function ownsProfile(userId) {
      let userPath = /databases/(default)/documents/users/$(userId);
      return request.auth != null
        && firestore.exists(userPath)
        && firestore.get(userPath).data.firebaseUid == request.auth.uid;
    }

    function validImage(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /profiles/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if ownsProfile(userId)
        && validImage(10 * 1024 * 1024);
      allow delete: if ownsProfile(userId);
    }

    match /posts/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if ownsProfile(userId)
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 100 * 1024 * 1024
        && (request.resource.contentType.matches('image/(jpeg|png|webp)')
          || request.resource.contentType.matches('video/(mp4|webm|quicktime)'));
      allow delete: if ownsProfile(userId);
    }

    match /alliances/{allianceId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && validImage(10 * 1024 * 1024);
      allow delete: if false;
    }

    match /chat_media/{chatId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 100 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*'));
      allow delete: if false;
    }

    match /voice_messages/{chatId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if false;
    }

    match /chat_files/{chatId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'text/plain'
          || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument/.*'));
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
