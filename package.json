{
  "name": "gesbx",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "server": "node server.js",
    "dev:all": "node scripts/dev-with-server.mjs",
    "dev:firebase": "npm run firebase:emulators",
    "build": "next build",
    "vercel-build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:battle-security": "npx tsx --test app/lib/battleSecurity/battleSecurityAudit.test.ts",
    "test:alliance-battle-access": "npx tsx --test app/lib/allianceBattleAccess.test.ts",
    "test:arena-match": "npx tsx --test app/game/arena/match/arenaMatch.test.ts app/game/arena/match/arenaLoadout.test.ts app/game/arena/match/effects/arenaEffects.test.ts app/game/arena/match/effects/arenaInteraction.test.ts app/game/arena/match/reaction/arenaReaction.test.ts app/game/arena/match/arenaCompletion.test.ts app/game/arena/match/arenaHistory.test.ts app/game/arena/match/arenaReward.test.ts app/game/arena/match/arenaWeeklySettlement.test.ts app/game/arena/match/arenaPayoutCheck.test.ts",
    "test:battle-e2e": "npx tsx --test --test-concurrency=1 app/lib/battleE2E/battlePipeline.e2e.test.ts",
    "test:firestore-rules": "firebase emulators:exec --only firestore,storage \"node --test scripts/firestore-rules.test.mjs\"",
    "firebase:login": "firebase login",
    "firebase:use": "firebase use gesbx-c4312",
    "firebase:check": "node scripts/firebase-check.mjs",
    "firebase:deploy": "firebase deploy --project gesbx-c4312 --only firestore:rules,firestore:indexes,hosting",
    "firebase:deploy:all": "npm run build && firebase deploy --project gesbx-c4312 --only firestore:rules,firestore:indexes,hosting",
    "firebase:hosting": "firebase deploy --project gesbx-c4312 --only hosting",
    "firebase:rules": "firebase deploy --project gesbx-c4312 --only firestore:rules,firestore:indexes",
    "firebase:emulators": "firebase emulators:start --only auth,firestore,storage,functions",
    "android:sync": "npx cap sync android",
    "android:build": "npm run build && npm run android:sync",
    "release:android": "npm run firebase:deploy && npm run android:build",
    "release:web": "npm run firebase:deploy:all"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.3",
    "@react-google-maps/api": "^2.20.8",
    "@zegocloud/zego-uikit-prebuilt": "^2.18.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.9.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.34.0",
    "next": "16.3.1",
    "pixi.js": "^8.8.1",
    "pixi3d": "^2.5.0",
    "pixi7": "npm:pixi.js@^7.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "react-leaflet": "^5.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.174.0",
    "zego-zim-web": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.174.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "firebase-tools": "^14.27.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
