# Copy public app settings to .env.local. Never put server secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=your_recaptcha_enterprise_site_key
NEXT_PUBLIC_ZEGO_APP_ID=your_zego_app_id
NEXT_PUBLIC_SOCKET_URL=https://your-socket-host.example
NEXT_PUBLIC_GOOGLE_ADS_CLIENT=your_ads_client
NEXT_PUBLIC_GOOGLE_ADS_SLOT=your_ads_slot
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Functions runtime (set ZEGO_SERVER_SECRET with Firebase Secret Manager, not here).
ZEGO_APP_ID=your_zego_app_id

# Optional standalone Socket.IO service. Set these on its host as well as the web client URL.
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=your_project_id
# Firebase Web API key (public); used only to validate socket ID tokens through Firebase Auth.
FIREBASE_API_KEY=your_firebase_web_api_key

# Configure separately with Firebase Secret Manager:
# firebase functions:secrets:set ZEGO_SERVER_SECRET
# firebase functions:secrets:set ADMIN_UIDS
